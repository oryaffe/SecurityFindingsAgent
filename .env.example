# Copy to .env in the project root. Never commit the populated .env.
# Obtain an API key from your own Anthropic account.
ANTHROPIC_API_KEY=

# Required for Web JWT signing. Generate a unique random value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional: this is the default model identifier in the supplied source.
# Availability depends on your API account; adjust only to a compatible model.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
JWT_EXPIRE_MINUTES=480

# Optional model cache location. Use the same location and OS user for
# model download, index building, and runtime. Set before starting Python.
# HF_HOME=/absolute/path/to/huggingface-cache

# Runtime retrieval defaults these to 1 in policy_retriever.py.
# Initial model download must run with offline flags unset or set to 0.
# These import-time settings should be configured in the process environment.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
